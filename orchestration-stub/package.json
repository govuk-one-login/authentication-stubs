{
  "dependencies": {
    "esbuild": "0.28.1",
    "jose": "6.2.10"
  },
  "description": "Orchestration stub for Authentication",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "8.10.161",
    "@types/chai": "5.2.3",
    "@types/express": "^5.0.3",
    "@types/mocha": "10.0.10",
    "@types/node": "24.13.3",
    "@types/sinon": "21.0.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.31.0",
    "c8": "12.0.0",
    "chai": "6.2.2",
    "eslint": "^10.8.1",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "express": "^5.1.0",
    "globals": "^17.11.0",
    "mocha": "12.0.0",
    "prettier": "3.9.6",
    "sinon": "22.0.0",
    "tsx": "4.23.12",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": "24.22.1"
  },
  "license": "MIT",
  "main": "index.js",
  "name": "orch-stub",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --minify --sourcemap --platform=node --outdir=build",
    "compile": "tsc",
    "lint": "eslint . --fix",
    "pretty": "prettier --write '**/*.ts' '**/*.js'",
    "pretty-check": "prettier --check '**/*.ts' '**/*.js'",
    "test-unit": "mocha",
    "test-unit:coverage": "c8 mocha"
  },
  "version": "1.0.0",
  "mocha": {
    "diff": true,
    "extension": [
      "js",
      "ts"
    ],
    "timeout": 20000,
    "recursive": true,
    "import": "tsx",
    "exit": true
  },
  "c8": {
    "all": true,
    "src": [
      "src"
    ],
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "src/server.ts",
      "src/types/**"
    ],
    "reporter": [
      "text",
      "lcov"
    ],
    "reports-dir": "coverage"
  },
  "overrides": {
    "uuid": ">=11.1.1",
    "brace-expansion": ">=5.0.7"
  }
}
